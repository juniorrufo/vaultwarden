# ==============================================================================
# Vaultwarden Environment Variables - Template / Exemplo
# ==============================================================================
# ATENÇÃO: Nunca versione o arquivo .env real com segredos de produção no Git.
# No servidor, este arquivo é mantido em /opt/vaultwarden/.env com permissões restritas.
# ==============================================================================

# URL pública através da qual o Vaultwarden é acessado (gerenciada via Cloudflare)
DOMAIN=https://vault.exemplo.com.br

# Endereço de escuta da aplicação dentro do container (0.0.0.0 escuta no container)
BIND_ADDRESS=0.0.0.0

# Registro de novos usuários (desativado em produção para evitar cadastros indevidos)
SIGNUPS_ALLOWED=false

# Envio de convites para novos usuários
INVITATIONS_ALLOWED=false

# Exibição de dicas de senha mestre na tela de login
PASSWORD_HINTS_ALLOWED=false
